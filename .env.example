# Provider selection: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Runtime controls
PROMPT_VERSION=v2
MAX_RETRIES=2
MAX_OUTPUT_TOKENS=500
TEMPERATURE=0

# Estimated pricing in USD per 1M tokens; update from provider's current pricing.
OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.60
ANTHROPIC_INPUT_USD_PER_1M=0.80
ANTHROPIC_OUTPUT_USD_PER_1M=4.00

# Optional: reject obvious malicious instructions before calling the model.
ENABLE_INJECTION_GUARD=true
